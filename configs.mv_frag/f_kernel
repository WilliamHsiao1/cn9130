#-----------------------------------------------------------------------------
# Copy-and-reconfig kernel.config
#  DO_NOT_COPY_RECONFIG in Base-SDK and if kernel.config file is already exist
#-----------------------------------------------------------------------------
#  Don't forget
#  - to set the required {kconfig_name} variable
#  - set the required PARAMETER string(with NO prefix CONFIG_)
#      for relevan actions {enable|disable|set-str}
# ----------------------------------------------------------------------------
DO_NOT_COPY_RECONFIG=true
if [[ ! $DO_NOT_COPY_RECONFIG ]]; then

kconfig_name=marvell_v8_octeon_kernel_nf.config

base_sdk_dir=$PWD/../sdk-base
base_sdk_kconfig_dir=$base_sdk_dir/board/marvell
solution_kconfig_dir=$PWD/board/marvell
base_sdk_kconfig=$base_sdk_kconfig_dir/${kconfig_name}
solution_kconfig=$solution_kconfig_dir/${kconfig_name}
config_sh=${base_sdk_dir}/scripts/config.sh

if [[ ! -e $solution_kconfig ]]; then

mkdir -p $solution_kconfig_dir
cp ${base_sdk_kconfig} ${solution_kconfig}

# Overwrite default prefix "BR2_" (config.sh), restore it at the end
CONFIG_orig=$CONFIG_
export CONFIG_="CONFIG_"
# ${config_sh} --file $solution_kconfig --enable  <KPARAM_A>
# ${config_sh} --file $solution_kconfig --disable <KPARAM_B>
# ${config_sh} --file $solution_kconfig --set-str <KPARAM_C> \"string to be set\"
CONFIG_=$CONFIG_orig

fi ;#if [[ ! -e $solution_kconfig ]]

fi ;#DO_NOT_COPY_RECONFIG
