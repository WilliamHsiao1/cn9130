config BR2_PACKAGE_LIBTMC
	bool "libtmc"
	help
	  Task isolation support.

	  This is the userspace part of the task isolation support for
	  Linux. It requires task isolation patch applied to he
	  kernel.

	  That patch is based on the task isolation patch v15 by Chris
	  Metcalf <cmetcalf@mellanox.com> ported to kernel 4.9.x, plus
	  the update that disables timers while isolated tasks are
	  running.

if BR2_PACKAGE_LIBTMC

choice
	prompt "libtmc-version"
	default BR2_PACKAGE_LIBTMC_RELEASE

config BR2_PACKAGE_LIBTMC_CUSTOM_GIT
	bool "Custom Git repository"
	help
	  Allows to specify custom repository for the component
	  Useful for developers building out of bleeding edge sources

config BR2_PACKAGE_LIBTMC_GIT
	bool "Obtain package from the development GIT"

config BR2_PACKAGE_LIBTMC_CUSTOM_TARBALL
	bool "Release sources supplied as archives"
	help
	  Use the package sources from local archive

config BR2_PACKAGE_LIBTMC_RELEASE
	bool "Release archives"
	help
	  Use the package sources specified in this SDK release

endchoice

if BR2_PACKAGE_LIBTMC_CUSTOM_GIT

config BR2_PACKAGE_LIBTMC_CUSTOM_REPO_URL
	string "URL of custom repository"

config BR2_PACKAGE_LIBTMC_CUSTOM_REPO_VERSION
	string "Custom repository version"
	help
	  Revision to use in the typical format used by Git
	  E.G. a sha id, a tag, branch, ..

endif

config BR2_PACKAGE_LIBTMC_CUSTOM_TARBALL_LOCATION
	string "Name of local archive file with release"

config BR2_PACKAGE_LIBTMC_VERSION
	string
	default "libtmc-devel" if BR2_PACKAGE_LIBTMC_GIT
	default BR2_MARVELL_RELEASE_ID if BR2_PACKAGE_LIBTMC_CUSTOM_TARBALL
	default BR2_MARVELL_RELEASE_ID if BR2_PACKAGE_LIBTMC_RELEASE
	default BR2_PACKAGE_LIBTMC_CUSTOM_REPO_VERSION if BR2_PACKAGE_LIBTMC_CUSTOM_GIT

endif
