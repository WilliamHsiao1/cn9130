config BR2_PACKAGE_MRVL_MCP_SHM
	bool "mrvl-mcp-shm"
	depends on BR2_LINUX_KERNEL
	depends on BR2_TOOLCHAIN_HAS_THREADS # libnl
	select BR2_PACKAGE_LIBOPING
	select BR2_PACKAGE_LIBNL
	select BR2_PACKAGE_INIH
	help
		Marvell share memory kernel module and utils.

if BR2_PACKAGE_MRVL_MCP_SHM

choice
        prompt "mrvl-mcp-shm-version"
        default BR2_PACKAGE_MRVL_MCP_SHM_RELEASE

config BR2_PACKAGE_MRVL_MCP_SHM_GIT
        bool "Obtain package from the development GIT"

config BR2_PACKAGE_MRVL_MCP_SHM_RELEASE
        bool "Release archives"
        help
          Use the package sources specified in this SDK release

endchoice

config BR2_PACKAGE_MRVL_MCP_SHM_VERSION
        string
        default "mrvl-mcp-shm-devel" if BR2_PACKAGE_MRVL_MCP_SHM_GIT
        default BR2_MARVELL_RELEASE_ID if BR2_PACKAGE_MRVL_MCP_SHM_RELEASE

endif


