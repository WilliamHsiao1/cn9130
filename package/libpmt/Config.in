config BR2_PACKAGE_LIBPMT
	bool "libpmt"
	help
	  This is a small C static library focused on providing
	  low-latency tracing for ARMv8 applications. Each trace
	  is identified by an application defined trace ID and
	  contains value of the PMU Cycle Counter register (PMCCNTR).

if BR2_PACKAGE_LIBPMT

choice
	prompt "libpmt-version"
	default BR2_PACKAGE_LIBPMT_RELEASE

config BR2_PACKAGE_LIBPMT_CUSTOM_GIT
	bool "Custom Git repository"
	help
	  Allows to specify custom repository for the component
	  Useful for developers building out of bleeding edge sources

config BR2_PACKAGE_LIBPMT_GIT
	bool "Obtain package from the development GIT"

config BR2_PACKAGE_LIBPMT_CUSTOM_TARBALL
	bool "Release sources supplied as archives"
	help
	  Use the package sources from local archive

config BR2_PACKAGE_LIBPMT_RELEASE
	bool "Release archives"
	help
	  Use the package sources specified in this SDK release

endchoice

if BR2_PACKAGE_LIBPMT_CUSTOM_GIT

config BR2_PACKAGE_LIBPMT_CUSTOM_REPO_URL
	string "URL of custom repository"

config BR2_PACKAGE_LIBPMT_CUSTOM_REPO_VERSION
	string "Custom repository version"
	help
	  Revision to use in the typical format used by Git
	  E.G. a sha id, a tag, branch, ..

endif

config BR2_PACKAGE_LIBPMT_CUSTOM_TARBALL_LOCATION
	string "Name of local archive file with release"

config BR2_PACKAGE_LIBPMT_VERSION
	string
	default "libpmt-devel" if BR2_PACKAGE_LIBPMT_GIT
	default BR2_MARVELL_RELEASE_ID if BR2_PACKAGE_LIBPMT_CUSTOM_TARBALL
	default BR2_MARVELL_RELEASE_ID if BR2_PACKAGE_LIBPMT_RELEASE
	default BR2_PACKAGE_LIBPMT_CUSTOM_REPO_VERSION if BR2_PACKAGE_LIBPMT_CUSTOM_GIT

endif
