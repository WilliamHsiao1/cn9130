	$(MARVELL_EXTERNAL_FW_EXTRACT_MCP_CMDS)
	$(MARVELL_EXTERNAL_FW_EXTRACT_UEFI_CMDS)
	$(MARVELL_EXTERNAL_FW_EXTRACT_CS_SDK_CMDS)
	$(MARVELL_EXTERNAL_FW_EXTRACT_PEMEP_CMDS)
	$(MARVELL_EXTERNAL_FW_EXTRACT_MBEDTLS_CMDS)
	$(MARVELL_EXTERNAL_FW_EXTRACT_LIBTIM_CMDS)
	$(MARVELL_EXTERNAL_FW_EXTRACT_LIBPLDM_CMDS)
	$(MARVELL_EXTERNAL_FW_EXTRACT_LIBMCTP_CMDS)
	$(MARVELL_EXTERNAL_FW_EXTRACT_PLDMD_CMDS)
	$(MARVELL_EXTERNAL_FW_EXTRACT_MCTPD_CMDS)
endef

ifeq ($(BR2_TARGET_MARVELL_EXTERNAL_FW_UEFI),y)
ifneq ($(filter $(BR2_MARVELL_SOC_FAMILY),"CN10K" "CN20K"),)
MARVELL_EXTERNAL_FW_IMG_USED = sdk-clean sdk-build BOOTLOADER=uefi
else
MARVELL_EXTERNAL_FW_IMG_USED = uefi-clean uefi-build
endif
ifeq ($(BR2_TARGET_MARVELL_EXTERNAL_FW_UEFI_SIGNED_CN10k),y)
MARVELL_EXTERNAL_FW_MAKE_OPTS += TRUST_MODE=secure KEY_YAML_FILE=$(patsubst "%",%,$(BR2_TARGET_MARVELL_EXTERNAL_FW_KEY_YAML_LOC)) \
				 KEY_DIR=$(patsubst "%",%,$(BR2_TARGET_MARVELL_EXTERNAL_FW_KEY_DIR))
endif
else ifeq ($(BR2_TARGET_MARVELL_EXTERNAL_FW_SIGNED_TRUSTED),y)

ifneq ($(filter $(BR2_MARVELL_SOC_FAMILY),"CN10K" "CN20K"),)
MARVELL_EXTERNAL_FW_IMG_USED = sdk-clean sdk-build BOOTLOADER=uboot 
MARVELL_EXTERNAL_FW_MAKE_OPTS += TRUST_MODE=secure KEY_YAML_FILE=$(patsubst "%",%,$(BR2_TARGET_MARVELL_EXTERNAL_FW_KEY_YAML_LOC)) \
				KEY_DIR=$(patsubst "%",%,$(BR2_TARGET_MARVELL_EXTERNAL_FW_KEY_DIR))
ifeq ($(BR2_MARVELL_SOC_FAMILY), "CN20K")
MARVELL_EXTERNAL_FW_MAKE_OPTS += BUILD_SCP=1 NEED_BL32=yes
endif
else 
MARVELL_EXTERNAL_FW_IMG_USED = secure-uboot-clean secure-uboot-build 
#ROT=rot_key.pem 
MARVELL_EXTERNAL_FW_MAKE_OPTS += ROT=$(patsubst "%",%,$(BR2_TARGET_MARVELL_EXTERNAL_FW_SIGNED_TRUSTED_VARS))
endif
ifeq ($(BR2_TARGET_MARVELL_EXTERNAL_FW_CREATE_FIT_IMAGE),y)
export FW_CREATE_FIT=$(BR2_TARGET_MARVELL_EXTERNAL_FW_CREATE_FIT_IMAGE)
export FW_FIT_DIR=$(BR2_TARGET_MARVELL_EXTERNAL_FW_FIT_DIR)
MARVELL_EXTERNAL_FW_MAKE_OPTS += FIT_DIR=$(BR2_TARGET_MARVELL_EXTERNAL_FW_FIT_DIR)
endif

else
ifneq ($(filter $(BR2_MARVELL_SOC_FAMILY),"CN10K" "CN20K"),)
MARVELL_EXTERNAL_FW_IMG_USED = sdk-clean sdk-build BOOTLOADER=uboot
else
MARVELL_EXTERNAL_FW_IMG_USED = uboot-clean uboot-build
endif
ifeq ($(BR2_TARGET_MARVELL_EXTERNAL_FW_CREATE_FIT_IMAGE),y)
export FW_CREATE_FIT=$(BR2_TARGET_MARVELL_EXTERNAL_FW_CREATE_FIT_IMAGE)
export FW_FIT_DIR=$(BR2_TARGET_MARVELL_EXTERNAL_FW_FIT_DIR)
MARVELL_EXTERNAL_FW_MAKE_OPTS += KEY_DIR=$(BR2_TARGET_MARVELL_EXTERNAL_FW_FIT_DIR)/default/keys
MARVELL_EXTERNAL_FW_MAKE_OPTS += ITS_FILE=$(BR2_TARGET_MARVELL_EXTERNAL_FW_FIT_DIR)/dummy/default.its
MARVELL_EXTERNAL_FW_MAKE_OPTS += FIT_DIR=$(BR2_TARGET_MARVELL_EXTERNAL_FW_FIT_DIR)
MARVELL_EXTERNAL_FW_DEPENDENCIES += host-uboot-tools uboot-tools
endif
endif

#GENERATE ENCRYPTED IMAGE
ifeq ($(BR2_TARGET_MARVELL_EXTERNAL_FW_SIGNED_ENCRYPTED),y)
ifeq ($(BR2_TARGET_MARVELL_EXTERNAL_FW_HUK),"")
MARVELL_EXTERNAL_FW_MAKE_OPTS += SSK=$(patsubst "%",%,$(BR2_TARGET_MARVELL_EXTERNAL_FW_SSK))
else
MARVELL_EXTERNAL_FW_MAKE_OPTS += HUK=$(patsubst "%",%,$(BR2_TARGET_MARVELL_EXTERNAL_FW_HUK))
endif
MARVELL_EXTERNAL_FW_MAKE_ENCRYPTED = $(MAKE) -C $(@D) secure-rot-key PLAT=$(MARVELL_EXTERNAL_FW_PLATFORM)
endif

ifeq ($(BR2_PACKAGE_OPTEE),y)
MARVELL_EXTERNAL_FW_DEPENDENCIES += optee
MARVELL_EXTERNAL_FW_MAKE_OPTS += \
        NEED_BL32=yes \
        SPD=opteed \
	OPTEE_BUILDROOT=1
MARVELL_EXTERNAL_FW_OPTEE_BIN_HOOK = cp $(@D)/firmware/optee/out/arm-plat-marvell/core/tee.bin $(BINARIES_DIR)/
ifneq ($(filter $(BR2_MARVELL_SOC_FAMILY),"CN10K" "CN20K"),)
MARVELL_EXTERNAL_FW_MAKE_OPTS += INCLUDE_OPTEE=1
endif
ifeq ($(BR2_MARVELL_SOC_FAMILY), "CN20K")
export CSSDK_ROOT=$(@D)/firmware/chip-security-sdk/
endif
define MARVELL_EXTERNAL_FW_OPTEE_LINK_CMDS
	ln -s $(OPTEE_DIR) $(@D)/firmware/optee
endef
endif

#FW_PIE_IMAGE
ifeq ($(BR2_TARGET_MARVELL_EXTERNAL_FW_PIE_IMAGE),y)
MARVELL_EXTERNAL_FW_MAKE_OPTS += PIE_IMAGE=1

ifneq ($(BR2_TARGET_MARVELL_EXTERNAL_FW_SIGNED_TRUSTED),y)
MARVELL_EXTERNAL_FW_MAKE_OPTS += KEY_YAML_FILE=$(patsubst "%",%,$(BR2_TARGET_MARVELL_EXTERNAL_FW_KEY_YAML_LOC))
endif
endif

ifneq ($(BR2_TARGET_MARVELL_EXTERNAL_FW_EBF_EXTRA_DTS_DIR),)
MARVELL_EXTERNAL_FW_MAKE_OPTS += \
	EXTRA_EBF_DTS_DIR=$(BR2_TARGET_MARVELL_EXTERNAL_FW_EBF_EXTRA_DTS_DIR)
endif

ifeq ($(BR2_MARVELL_SOC_FAMILY), "CN10K")
	MARVELL_EXTERNAL_FW_SOC_TARGET=cn10k
	MARVELL_EXTERNAL_FW_SCP_BL0_BIN_HOOK = cp $(@D)/firmware/ebf/cn10k/target-bin/scp_bl0.exe-cn10xx $(BINARIES_DIR)/scp_bl0.exe-${MARVELL_EXTERNAL_FW_PLATFORM}
else ifeq ($(BR2_MARVELL_SOC_FAMILY), "CN20K")
	MARVELL_EXTERNAL_FW_SOC_TARGET=cn20k
endif

define MARVELL_EXTERNAL_FW_COPY_BINARIES
if [ `ls -1 $(@D)/target/$(MARVELL_EXTERNAL_FW_SOC_TARGET)/images/*.bin 2>/dev/null | wc -l ` -gt 0 ]; then \
cp $(@D)/target/$(MARVELL_EXTERNAL_FW_SOC_TARGET)/images/*.bin $(BINARIES_DIR) ; \
fi
endef

ifeq ($(BR2_TARGET_MARVELL_EXTERNAL_FW_UEFI),y)
	MARVELL_EXTERNAL_FW_IMAGE_NAME=flash-uefi-$(MARVELL_EXTERNAL_FW_PLATFORM)
else
	MARVELL_EXTERNAL_FW_IMAGE_NAME=flash-$(MARVELL_EXTERNAL_FW_PLATFORM)
endif
define MARVELL_EXTERNAL_FW_COPY_FWIMG
	cp $(@D)/target/$(MARVELL_EXTERNAL_FW_SOC_TARGET)/images/$(MARVELL_EXTERNAL_FW_IMAGE_NAME).img $(BINARIES_DIR)/marvell-fw.img
endef

define MARVELL_EXTERNAL_FW_BUILD_CMDS
	$(MARVELL_EXTERNAL_FW_OPTEE_LINK_CMDS)
	$(MARVELL_EXTERNAL_FW_MAKE_ENCRYPTED)
	$(TARGET_MAKE_ENV) PATH=$(HOST_DIR)/sbin:$(HOST_DIR)/usr/bin:$(PATH):$(@D)/tools/bin CROSS_COMPILE_M7=$(CROSS_COMPILE_M7) CROSS_COMPILE=$(@D)/tools/bin/aarch64-none-linux-gnu- $(MAKE) -C $(@D) $(MARVELL_EXTERNAL_FW_IMG_USED) PLAT=$(MARVELL_EXTERNAL_FW_PLATFORM) $(MARVELL_EXTERNAL_FW_MAKE_OPTS) $(MARVELL_EXTERNAL_FW_DEFS)
endef

define MARVELL_EXTERNAL_FW_INSTALL_TARGET_CMDS
	cp $(@D)/target/$(MARVELL_EXTERNAL_FW_SOC_TARGET)/images/*.img* $(BINARIES_DIR)
	$(MARVELL_EXTERNAL_FW_SCP_BL0_BIN_HOOK)
	$(MARVELL_EXTERNAL_FW_OPTEE_BIN_HOOK)
endef

MARVELL_EXTERNAL_FW_POST_INSTALL_TARGET_HOOKS += MARVELL_EXTERNAL_FW_COPY_BINARIES
ifneq ($(filter $(BR2_MARVELL_SOC_FAMILY),"CN10K" "CN20K"),)
MARVELL_EXTERNAL_FW_POST_INSTALL_TARGET_HOOKS += MARVELL_EXTERNAL_FW_COPY_FWIMG
endif

$(eval $(generic-package))
