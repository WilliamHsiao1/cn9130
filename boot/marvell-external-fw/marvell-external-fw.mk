ifeq ($(BR2_MARVELL_EXTERNAL_FW_MCP_BUILD),y)
ifeq ($(BR2_MARVELL_SOC_FAMILY),"CN10K")
# Set MIPS toolchain path and URLs
MIPS_PATH = $(HOME)/codescape
MIPS_URL = "https://artifactory.marvell.com/artifactory/sources.buildroot-virtual/Codescape.GNU.Tools.Package.2017.10-08.for.MIPS.MTI.Bare.Metal.CentOS-5.x86_64.tar.gz"
MIPS_TAR = ${MIPS_PATH}/mips_toolchain.tar.gz

define MARVELL_EXTERNAL_FW_MIPS_MCP
		echo "Create directory for MIPS toolchain if not exists"
		mkdir -p ${MIPS_PATH}
		# Check if the toolchain file already exists
		if [ -f ${MIPS_TAR} ]; then \
			echo "MIPS toolchain file already exists at ${MIPS_TAR}. Skipping download."; \
		else \
			echo "Downloading MIPS toolchain..."; \
			wget -O ${MIPS_TAR} ${MIPS_URL}; \
		fi
		# Extract toolchain
		if [ -f ${MIPS_TAR} ]; then \
			echo "Extracting MIPS toolchain..."; \
			tar -xzf ${MIPS_TAR} -C ${MIPS_PATH}; \
		else \
			echo "Error: MIPS toolchain archive not found!"; \
			exit 1; \
		fi
endef
endif
endif

