	string "Name of local archive file with release"

endif

config BR2_TARGET_MARVELL_EXTERNAL_FW_EBF_EXTRA_DTS_DIR
	string "Path to directory with all extra board dts or board.c"

config BR2_TARGET_MARVELL_EXTERNAL_FW_UEFI
        bool "Marvell uefi"
        help
          Enable this option if you want to build uefi image

if BR2_TARGET_MARVELL_EXTERNAL_FW_UEFI

choice
        prompt "marvell-external-fw-uefi-version"
        default BR2_TARGET_MARVELL_EXTERNAL_FW_UEFI_CUSTOM_TARBALL

config BR2_TARGET_MARVELL_EXTERNAL_FW_UEFI_CUSTOM_GIT
        bool "Custom Git repository"
        help
          Allows to specify custom repository for the component
          Useful for developers building out of bleeding edge sources

config BR2_TARGET_MARVELL_EXTERNAL_FW_UEFI_CUSTOM_TARBALL
        bool "Release sources supplied as archives"
        help
          Use the package sources from local archive

endchoice

if BR2_TARGET_MARVELL_EXTERNAL_FW_UEFI_CUSTOM_GIT

config BR2_TARGET_MARVELL_EXTERNAL_FW_UEFI_CUSTOM_REPO_URL
        string "URL of custom repository"

config BR2_TARGET_MARVELL_EXTERNAL_FW_UEFI_CUSTOM_REPO_VERSION
        string "Custom repository version"
        help
          Revision to use in the typical format used by Git
          E.G. a sha id, a tag, branch, ..

endif

if BR2_TARGET_MARVELL_EXTERNAL_FW_UEFI_CUSTOM_TARBALL

config BR2_TARGET_MARVELL_EXTERNAL_FW_UEFI_CUSTOM_TARBALL_LOCATION
        string "Name of local archive file with release"

endif

config BR2_TARGET_MARVELL_EXTERNAL_FW_UEFI_SIGNED_CN10k
        bool "Uefi cn10k signed builds"
        default n
        help
          Uefi signed builds

endif #IF UEFI SELECTED
config BR2_TARGET_MARVELL_EXTERNAL_FW_CREATE_FIT_IMAGE
        bool "Create FIT image"
        default n
        select BR2_PACKAGE_HOST_UBOOT_TOOLS
        select BR2_PACKAGE_HOST_UBOOT_TOOLS_FIT_SUPPORT
        select BR2_PACKAGE_HOST_UBOOT_TOOLS_FIT_SIGNATURE_SUPPORT
        help
          Create Flattened Image Tree file.
          This option does not create any image files, but
          creates a configuration file in the images directory
          which is later used to create the actual .itb file
          after filesystem image is created.

config BR2_TARGET_MARVELL_EXTERNAL_FW_FIT_DIR
        string "Directory contains FIT config file"
        depends on BR2_TARGET_MARVELL_EXTERNAL_FW_CREATE_FIT_IMAGE
        default "$(BR2_EXTERNAL_MARVELL_SDK_PATH)/board/marvell/fit/default"
        help
          This is the direcotry contains FIT config file(its) 
          and signature key. Folder structure refer to 
          board/marvell/fit/default

config BR2_TARGET_MARVELL_EXTERNAL_FW_PIE_IMAGE
	bool "Marvell PIE IMAGE"
        help
          Enable this option if you want PIE IMAGE


config BR2_TARGET_MARVELL_EXTERNAL_FW_SIGNED_TRUSTED
        bool "Marvell secure boot"
        help
          Enable this option if you want to use secure boot

config BR2_TARGET_MARVELL_EXTERNAL_FW_SIGNED_ENCRYPTED
	bool "Marvell secure boot, Encrypted Image"
        help
          Enable this option to generate ROT_KEY, and use secure
	  encrypted boot

if BR2_TARGET_MARVELL_EXTERNAL_FW_SIGNED_TRUSTED

choice
        prompt "marvell-external-fw-mbedtls-version"
        default BR2_TARGET_MARVELL_EXTERNAL_FW_MBEDTLS_CUSTOM_TARBALL

config BR2_TARGET_MARVELL_EXTERNAL_FW_MBEDTLS_CUSTOM_GIT
        bool "Custom Git repository"
        help
          Allows to specify custom repository for the component
          Useful for developers building out of bleeding edge sources

config BR2_TARGET_MARVELL_EXTERNAL_FW_MBEDTLS_CUSTOM_TARBALL
        bool "Release sources supplied as archives"
        help
          Use the package sources from local archive

endchoice

if BR2_TARGET_MARVELL_EXTERNAL_FW_MBEDTLS_CUSTOM_GIT

config BR2_TARGET_MARVELL_EXTERNAL_FW_MBEDTLS_CUSTOM_REPO_URL
        string "URL of custom repository"

config BR2_TARGET_MARVELL_EXTERNAL_FW_MBEDTLS_CUSTOM_REPO_VERSION
        string "Custom repository version"
        help
          Revision to use in the typical format used by Git
          E.G. a sha id, a tag, branch, ..

endif

if BR2_TARGET_MARVELL_EXTERNAL_FW_MBEDTLS_CUSTOM_TARBALL

config BR2_TARGET_MARVELL_EXTERNAL_FW_MBEDTLS_CUSTOM_TARBALL_LOCATION
        string "Name of local archive file with release"

endif

config BR2_TARGET_MARVELL_EXTERNAL_FW_SIGNED_TRUSTED_VARS
	string "Parameters passed to build command"

config BR2_TARGET_MARVELL_EXTERNAL_FW_IS_CN10k
	bool "If it is cn10k soc"

if BR2_TARGET_MARVELL_EXTERNAL_FW_IS_CN10k || BR2_TARGET_MARVELL_EXTERNAL_FW_UEFI_SIGNED_CN10k

config BR2_TARGET_MARVELL_EXTERNAL_FW_KEY_DIR
        string "KEY_DIR Parameter passed to build command"
        help
         Location of keys

endif #IF CN10k SoC

endif #IF SIGNED_TRUSTED SELECTED

if BR2_TARGET_MARVELL_EXTERNAL_FW_SIGNED_ENCRYPTED

config BR2_TARGET_MARVELL_EXTERNAL_FW_SSK
	string "SSK parameter"
	help
         SSK parameter for signed-encrypted image

config BR2_TARGET_MARVELL_EXTERNAL_FW_HUK
        string "HUK parameter"
        help
         HUK parameter for signed-encrypted image

endif #FW_SIGNED_TRUSTED

if BR2_TARGET_MARVELL_EXTERNAL_FW_IS_CN10k || BR2_TARGET_MARVELL_EXTERNAL_FW_UEFI_SIGNED_CN10k || BR2_TARGET_MARVELL_EXTERNAL_FW_PIE_IMAGE

config BR2_TARGET_MARVELL_EXTERNAL_FW_KEY_YAML_LOC
        string "Parameters passed to build command"
        help
         Location of key_yaml_file
endif

endif #IF FW SELECTED
