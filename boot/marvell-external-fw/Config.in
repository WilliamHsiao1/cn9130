config BR2_TARGET_MARVELL_EXTERNAL_FW
	bool "Marvell External Firmware"
	select BR2_PACKAGE_HOST_CMAKE
	select BR2_PACKAGE_PYTHON_PYYAML
	select BR2_PACKAGE_HOST_PYTHON_PYYAML
	select BR2_PACKAGE_PYTHON_PYYAML_INCLUDE
	select BR2_PACKAGE_PYTHON_PYCRYPTODOMEX
	select BR2_PACKAGE_PYTHON_WEST
	select BR2_PACKAGE_PYTHON_GIT
	help
	  Enable this option if you want to build the boot image
	  using external SDK

if BR2_TARGET_MARVELL_EXTERNAL_FW

config BR2_TARGET_MARVELL_EXTERNAL_FW_PLATFORM
	string "platform"

config BR2_MARVELL_EXTERNAL_FW_DEFS
	string "definitions"

choice
	prompt "marvell-external-fw-version"
	default BR2_TARGET_MARVELL_EXTERNAL_FW_CUSTOM_TARBALL

config BR2_TARGET_MARVELL_EXTERNAL_FW_CUSTOM_GIT
	bool "Custom Git repository"
	help
	  Allows to specify custom repository for the component
	  Useful for developers building out of bleeding edge sources

config BR2_TARGET_MARVELL_EXTERNAL_FW_CUSTOM_TARBALL
	bool "Release sources supplied as archives"
	help
	  Use the package sources from local archive

endchoice

if BR2_TARGET_MARVELL_EXTERNAL_FW_CUSTOM_GIT

config BR2_TARGET_MARVELL_EXTERNAL_FW_CUSTOM_REPO_URL
	string "URL of custom repository"

config BR2_TARGET_MARVELL_EXTERNAL_FW_CUSTOM_REPO_VERSION
	string "Custom repository version"
	help
	  Revision to use in the typical format used by Git
	  E.G. a sha id, a tag, branch, ..

endif

if BR2_TARGET_MARVELL_EXTERNAL_FW_CUSTOM_TARBALL

config BR2_TARGET_MARVELL_EXTERNAL_FW_CUSTOM_TARBALL_LOCATION
	string "Name of local archive file with release"

